<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseAppHost>true</UseAppHost>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>WebBridge.Utility</AssemblyName>
    <RootNamespace>WebBridge.Utility</RootNamespace>
    <Title>WebBridge.Utility</Title>
    <Product>WebBridge.Utility</Product>
    <Description>Локальная headless-утилита для связи веб-страницы с Excel, KOMPAS-3D и системными API.</Description>
    <Authors>Гороховицкий Егор Русланович</Authors>
    <Company>Гороховицкий Егор Русланович</Company>
    <Copyright>© Гороховицкий Егор Русланович</Copyright>
    <ApplicationIcon>Assets\utility-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <Target Name="RemovePublishedWebConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)web.config" />
    <Delete Files="$(PublishDir)$(AssemblyName).pdb" />
  </Target>
</Project>

